# Cloudflare Account Configuration
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_ZONE_ID=your_zone_id

# R2 Bucket Configuration
CF_R2_BUCKET_NAME=app-media-assets
CF_R2_PUBLIC_URL=https://assets.redwanmart.com
CF_R2_ACCOUNT_ID=your_account_id

# D1 Database Configuration
CF_D1_ID=app-db-production
CF_D1_NAME=app-db-production

# KV Namespace Configuration
CF_KV_NAMESPACE=app-cache
CF_KV_NAMESPACE_ID=your_kv_namespace_id

# Higgsfield AI Configuration
HIGGSFIELD_API_KEY=your_higgsfield_api_key
HIGGSFIELD_WORKSPACE_ID=your_workspace_id

# GitHub Configuration
GITHUB_TOKEN=your_github_token

# ── Authentication (required; endpoints fail closed without these) ──
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_min_32_chars

# The single admin account, until users move into D1.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use_a_long_random_password

# Bearer token guarding GET /api/analytics
ADMIN_ANALYTICS_TOKEN=another_long_random_token

# Application Configuration
ENVIRONMENT=development
APP_URL=http://localhost:3000
ASSETS_URL=https://assets.redwanmart.com
API_URL=https://api.redwanmart.com

# Feature Flags
ENABLE_CHECKOUT=true
ENABLE_USER_ACCOUNTS=true
ENABLE_AI_GENERATION=true
