---
// Admin Panel for Higgsfield AI Media Generation
---

<div class="higgsfield-panel bg-white rounded-lg shadow-lg p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-2xl font-bold text-rm-red">Higgsfield AI Media Generator</h2>
      <p class="text-gray-600 text-sm mt-1">Generate product images and videos with AI</p>
    </div>
    <div class="w-12 h-12 bg-rm-red rounded-full flex items-center justify-center text-white">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {/* Generation Form */}
    <div class="lg:col-span-1">
      <form id="higgsfield-form" class="space-y-4">
        {/* Product ID */}
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Product ID
          </label>
          <input
            type="text"
            id="productId"
            placeholder="prod_xxx"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rm-red focus:border-transparent outline-none"
            required
          />
        </div>

        {/* Prompt */}
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Prompt
          </label>
          <textarea
            id="prompt"
            placeholder="Describe the image or video you want to generate..."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rm-red focus:border-transparent outline-none resize-none"
            rows="4"
            required
          ></textarea>
          <p class="text-xs text-gray-500 mt-1">Be descriptive for better results</p>
        </div>

        {/* Media Type */}
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Media Type
          </label>
          <select
            id="type"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rm-red focus:border-transparent outline-none bg-white"
            required
          >
            <option value="image">Image</option>
            <option value="video">Video</option>
          </select>
        </div>

        {/* Dimensions */}
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Width
            </label>
            <input
              type="number"
              id="width"
              placeholder="1024"
              value="1024"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rm-red focus:border-transparent outline-none"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Height
            </label>
            <input
              type="number"
              id="height"
              placeholder="1024"
              value="1024"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rm-red focus:border-transparent outline-none"
            />
          </div>
        </div>

        {/* Generate Button */}
        <button
          type="submit"
          class="w-full bg-rm-red text-white font-semibold py-2 rounded-lg hover:bg-opacity-90 transition-all duration-200 flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
          id="generate-btn"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Generate</span>
        </button>

        {/* Status */}
        <div id="status-message" class="hidden p-3 rounded-lg text-sm"></div>
      </form>
    </div>

    {/* Gallery */}
    <div class="lg:col-span-2">
      <div class="mb-4">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Generated Media</h3>
        <p class="text-xs text-gray-500 mb-3">Recent generations will appear below</p>
      </div>

      <div
        id="media-gallery"
        class="grid grid-cols-2 gap-3 max-h-96 overflow-y-auto"
      >
        {/* Media items will be populated dynamically */}
        <div class="col-span-2 py-8 text-center text-gray-400">
          <svg class="w-12 h-12 mx-auto mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p>No media generated yet</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .higgsfield-panel {
    border: 1px solid #e5e7eb;
  }

  #status-message {
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .media-item {
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>

<script>
  interface MediaItem {
    url: string;
    type: 'image' | 'video';
    timestamp: string;
  }

  const form = document.getElementById('higgsfield-form') as HTMLFormElement;
  const statusMessage = document.getElementById('status-message') as HTMLDivElement;
  const gallery = document.getElementById('media-gallery') as HTMLDivElement;
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
  let generatedMedia: MediaItem[] = [];

  // Load media from localStorage
  function loadMedia() {
    const stored = localStorage.getItem('higgsfield_media');
    if (stored) {
      try {
        generatedMedia = JSON.parse(stored);
        renderGallery();
      } catch (e) {
        console.error('Failed to load media:', e);
      }
    }
  }

  // Save media to localStorage
  function saveMedia() {
    localStorage.setItem('higgsfield_media', JSON.stringify(generatedMedia));
  }

  // Render gallery
  function renderGallery() {
    if (generatedMedia.length === 0) {
      gallery.innerHTML = `
        <div class="col-span-2 py-8 text-center text-gray-400">
          <svg class="w-12 h-12 mx-auto mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p>No media generated yet</p>
        </div>
      `;
      return;
    }

    gallery.innerHTML = generatedMedia
      .slice()
      .reverse()
      .map((item) => `
        <div class="relative group rounded-lg overflow-hidden bg-gray-100">
          ${
            item.type === 'image'
              ? `<img src="${item.url}" alt="Generated" class="w-full h-full object-cover">`
              : `<video src="${item.url}" class="w-full h-full object-cover" controls></video>`
          }
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-all flex items-end justify-between p-2">
            <span class="text-white text-xs opacity-0 group-hover:opacity-100 transition-opacity">
              ${new Date(item.timestamp).toLocaleString()}
            </span>
            <a
              href="${item.url}"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-rm-red text-white p-1 rounded opacity-0 group-hover:opacity-100 transition-opacity"
              title="Open in new tab"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4m-4-4l4-4m0 0l4 4m-4-4v12" />
              </svg>
            </a>
          </div>
        </div>
      `)
      .join('');
  }

  // Show status message
  function showStatus(message: string, type: 'success' | 'error' | 'info' = 'info') {
    statusMessage.textContent = message;
    statusMessage.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800', 'bg-blue-50', 'text-blue-800');
    statusMessage.classList.add(
      type === 'success' ? 'bg-green-50 text-green-800' :
      type === 'error' ? 'bg-red-50 text-red-800' :
      'bg-blue-50 text-blue-800'
    );
  }

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const productId = (document.getElementById('productId') as HTMLInputElement).value;
    const prompt = (document.getElementById('prompt') as HTMLTextAreaElement).value;
    const type = (document.getElementById('type') as HTMLSelectElement).value as 'image' | 'video';
    const width = parseInt((document.getElementById('width') as HTMLInputElement).value);
    const height = parseInt((document.getElementById('height') as HTMLInputElement).value);

    if (!productId || !prompt) {
      showStatus('Please fill in all required fields', 'error');
      return;
    }

    generateBtn.disabled = true;
    showStatus('Generating media...', 'info');

    try {
      const token = localStorage.getItem('auth_token');
      const response = await fetch('/api/higgsfield', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token || ''}`,
        },
        body: JSON.stringify({
          prompt,
          type,
          productId,
          width,
          height,
        }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Failed to generate media');
      }

      const result = await response.json();

      if (result.success && result.url) {
        generatedMedia.push({
          url: result.url,
          type,
          timestamp: new Date().toISOString(),
        });
        saveMedia();
        renderGallery();

        showStatus(`${type === 'image' ? 'Image' : 'Video'} generated successfully!`, 'success');

        // Reset form
        (document.getElementById('prompt') as HTMLTextAreaElement).value = '';
      } else {
        throw new Error(result.error || 'Generation failed');
      }
    } catch (error) {
      showStatus(`Error: ${error instanceof Error ? error.message : 'Unknown error'}`, 'error');
    } finally {
      generateBtn.disabled = false;
    }
  });

  // Initialize
  loadMedia();
</script>
