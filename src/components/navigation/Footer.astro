---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Shop',
    links: [
      { label: 'All products', href: '/products' },
      { label: 'Hero Block series', href: '/products?series=Hero+Block' },
      { label: 'Spidey Block series', href: '/products?series=Spidey+Block' },
      { label: 'Anime Block series', href: '/products?series=Anime+Block' },
      { label: 'Mini Block series', href: '/products?series=Mini+Block' },
      { label: 'Search', href: '/search' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Redwan Mart', href: '/about' },
      { label: 'Founder', href: '/about#founder' },
      { label: 'Contact', href: 'mailto:redwanmartbd@gmail.com' },
    ],
  },
];
---

<footer class="mt-24 gradient-ink text-white/70">
  <div class="container-app py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" aria-label="Redwan Mart — home" class="inline-block">
          <img src="/brand/lockup-white.png" alt="Redwan Mart" width="803" height="173" class="h-11 w-auto" loading="lazy" />
        </a>
        <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed">
          Micro-brick hero figures, curated and shipped from Dhaka. Every set is
          checked in-house before it goes out the door.
        </p>
        <a href="mailto:redwanmartbd@gmail.com" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-gold-400">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
          redwanmartbd@gmail.com
        </a>
      </div>

      {columns.map((col) => (
        <div>
          <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-white">{col.title}</h2>
          <ul class="mt-5 space-y-3 text-[0.95rem]">
            {col.links.map((l) => (
              <li><a href={l.href} class="transition hover:text-gold-400">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm">&copy; {year} Redwan Mart. All rights reserved.</p>
      <p class="text-sm text-white/45">Founded by S. M. Redwan Ahmed · Dhaka, Bangladesh</p>
    </div>
  </div>
</footer>
