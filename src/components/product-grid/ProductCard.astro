---
import type { Product } from '../../data/products';
import { formatPrice } from '../../data/products';

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const discount = product.compareAt
  ? Math.round((1 - product.price / product.compareAt) * 100)
  : 0;
---

<article class="card group relative overflow-hidden hover:-translate-y-1 hover:shadow-lift">
  <a href={`/products/${product.id}`} class="block focus:outline-none">
    <span class="absolute inset-0 z-10" aria-hidden="true"></span>

    <div class="relative aspect-square overflow-hidden bg-surface-sunken">
      <picture>
        <source srcset={product.imageWebp} type="image/webp" />
        <img
          src={product.image}
          alt={`${product.name} — model ${product.model}`}
          width="1200" height="1200"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        />
      </picture>

      <div class="absolute left-3 top-3 flex flex-col items-start gap-2">
        {product.badge && (
          <span class="rounded-full bg-ink/90 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-wider text-white backdrop-blur">
            {product.badge}
          </span>
        )}
        {discount > 0 && (
          <span class="rounded-full bg-brand-600 px-3 py-1 text-[0.7rem] font-bold text-white">
            −{discount}%
          </span>
        )}
      </div>

      {!product.inStock && (
        <div class="absolute inset-0 grid place-items-center bg-white/70 backdrop-blur-[2px]">
          <span class="rounded-full bg-ink px-4 py-2 text-sm font-bold text-white">Sold out</span>
        </div>
      )}
    </div>

    <div class="p-5">
      <p class="text-[0.72rem] font-bold uppercase tracking-[0.14em] text-ink-faint">
        {product.series} · {product.model}
      </p>

      <h3 class="mt-2 line-clamp-2 text-[1.05rem] font-bold leading-snug text-ink transition group-hover:text-brand-700">
        {product.name}
      </h3>

      <div class="mt-2.5 flex items-center gap-1.5 text-sm">
        <span class="flex text-gold-400" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg class:list={['h-3.5 w-3.5', i < Math.round(product.rating) ? 'fill-current' : 'fill-surface-line']} viewBox="0 0 20 20">
              <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
            </svg>
          ))}
        </span>
        <span class="font-semibold text-ink">{product.rating.toFixed(1)}</span>
        <span class="text-ink-faint">({product.reviews})</span>
      </div>

      <div class="mt-4 flex items-end justify-between gap-3">
        <div class="flex items-baseline gap-2">
          <span class="text-xl font-bold text-ink">{formatPrice(product.price)}</span>
          {product.compareAt && (
            <span class="text-sm text-ink-faint line-through">{formatPrice(product.compareAt)}</span>
          )}
        </div>
        <span class="relative z-20 inline-flex h-9 w-9 items-center justify-center rounded-full bg-surface-sunken text-ink transition group-hover:bg-brand-600 group-hover:text-white">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>
