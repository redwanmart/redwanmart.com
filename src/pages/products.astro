---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product-grid/ProductCard.astro';

// Mock product data (will be replaced with database queries)
const allProducts = [
  {
    id: '1',
    name: 'Premium Wireless Headphones',
    price: 199.99,
    image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&h=500&fit=crop',
    category: 'Electronics',
    rating: 4.8,
    reviews: 245,
    inStock: true,
  },
  {
    id: '2',
    name: 'Smartwatch Pro Series',
    price: 349.99,
    image: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&h=500&fit=crop',
    category: 'Wearables',
    rating: 4.6,
    reviews: 189,
    inStock: true,
  },
  {
    id: '3',
    name: 'Ultra HD Camera',
    price: 899.99,
    image: 'https://images.unsplash.com/photo-1612198188060-c7c2a3b66eae?w=500&h=500&fit=crop',
    category: 'Photography',
    rating: 4.9,
    reviews: 156,
    inStock: true,
  },
  {
    id: '4',
    name: 'Portable Speaker',
    price: 79.99,
    image: 'https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?w=500&h=500&fit=crop',
    category: 'Audio',
    rating: 4.5,
    reviews: 312,
    inStock: true,
  },
  {
    id: '5',
    name: 'Wireless Charging Pad',
    price: 39.99,
    image: 'https://images.unsplash.com/photo-1591290619762-a3c5d2e45b58?w=500&h=500&fit=crop',
    category: 'Accessories',
    rating: 4.4,
    reviews: 423,
    inStock: true,
  },
  {
    id: '6',
    name: 'Premium Backpack',
    price: 129.99,
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&h=500&fit=crop',
    category: 'Bags',
    rating: 4.7,
    reviews: 278,
    inStock: false,
  },
  {
    id: '7',
    name: '4K Monitor',
    price: 549.99,
    image: 'https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?w=500&h=500&fit=crop',
    category: 'Electronics',
    rating: 4.6,
    reviews: 134,
    inStock: true,
  },
  {
    id: '8',
    name: 'Mechanical Keyboard',
    price: 159.99,
    image: 'https://images.unsplash.com/photo-1587829191301-dc798b83add3?w=500&h=500&fit=crop',
    category: 'Accessories',
    rating: 4.7,
    reviews: 203,
    inStock: true,
  },
];

const categories = ['All', ...new Set(allProducts.map(p => p.category))];
---

<BaseLayout title="Products - Redwan Mart">
  {/* Header */}
  <div class="bg-rm-gray text-white py-12">
    <div class="container-app">
      <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4">Our Products</h1>
      <p class="text-lg text-gray-300">
        Explore our complete collection of premium products
      </p>
    </div>
  </div>

  {/* Products Section */}
  <section class="py-16 md:py-24">
    <div class="container-app">
      {/* Filters */}
      <div class="mb-12">
        <h2 class="text-lg font-bold text-rm-gray mb-4">Categories</h2>
        <div class="flex flex-wrap gap-2">
          {categories.map((category) => (
            <button
              class={`px-4 py-2 rounded-full font-medium transition ${
                category === 'All'
                  ? 'bg-rm-red text-white'
                  : 'bg-gray-200 text-rm-gray hover:bg-rm-gold'
              }`}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      {/* Products Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {allProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      {/* Pagination */}
      <div class="mt-12 flex items-center justify-center gap-2">
        <button class="px-4 py-2 border border-rm-red text-rm-red rounded-lg hover:bg-rm-red hover:text-white transition">
          Previous
        </button>
        {[1, 2, 3, 4].map((page) => (
          <button
            key={page}
            class={`px-4 py-2 rounded-lg font-medium transition ${
              page === 1
                ? 'bg-rm-red text-white'
                : 'border border-rm-red text-rm-red hover:bg-rm-red hover:text-white'
            }`}
          >
            {page}
          </button>
        ))}
        <button class="px-4 py-2 border border-rm-red text-rm-red rounded-lg hover:bg-rm-red hover:text-white transition">
          Next
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
