---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product-grid/ProductCard.astro';
import { products, seriesList } from '../data/products';
---

<BaseLayout
  title="Shop all micro-brick figures | Redwan Mart"
  description="The full Redwan Mart range — Hero Block, Spidey Block, Anime Block and Mini Block micro-brick collectibles, in stock and shipped across Bangladesh."
  image="/og-image.jpg"
>
  <section class="border-b border-surface-line bg-surface-soft">
    <div class="container-app py-14 lg:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-muted">
        <a href="/" class="hover:text-brand-700">Home</a>
        <span class="mx-2 text-ink-faint">/</span>
        <span class="font-semibold text-ink">Shop</span>
      </nav>
      <h1 class="mt-4 text-title">The collection</h1>
      <p class="mt-3 max-w-2xl text-lg text-ink-soft">
        Every figure we carry, all in stock. Prices include the box, the bricks
        and the instruction booklet.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-app">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="hide-scrollbar -mx-1 flex gap-2 overflow-x-auto px-1 py-1" role="tablist" aria-label="Filter by series">
          {seriesList.map((s) => (
            <button
              type="button"
              class="filter-btn shrink-0 rounded-full border border-surface-line bg-white px-5 py-2.5 text-sm font-semibold text-ink-soft transition hover:border-ink/20 hover:text-ink aria-selected:border-brand-600 aria-selected:bg-brand-600 aria-selected:text-white"
              data-series={s}
              role="tab"
              aria-selected={s === 'All' ? 'true' : 'false'}
            >
              {s}
            </button>
          ))}
        </div>
        <p id="result-count" class="text-sm text-ink-muted">{products.length} products</p>
      </div>

      <div id="grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p, i) => (
          <div class="product-item" data-series={p.series}>
            <ProductCard product={p} priority={i < 3} />
          </div>
        ))}
      </div>

      <p id="empty" hidden class="mt-16 text-center text-lg text-ink-muted">
        Nothing in that series yet.
      </p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('.filter-btn')];
      const items = [...document.querySelectorAll('.product-item')];
      const count = document.getElementById('result-count');
      const empty = document.getElementById('empty');

      function apply(series, push) {
        let shown = 0;
        for (const el of items) {
          const match = series === 'All' || el.dataset.series === series;
          el.hidden = !match;
          if (match) shown++;
        }
        for (const b of buttons) {
          b.setAttribute('aria-selected', String(b.dataset.series === series));
        }
        if (count) count.textContent = `${shown} product${shown === 1 ? '' : 's'}`;
        if (empty) empty.hidden = shown !== 0;
        if (push) {
          const url = new URL(location.href);
          if (series === 'All') url.searchParams.delete('series');
          else url.searchParams.set('series', series);
          history.replaceState({}, '', url);
        }
      }

      for (const b of buttons) {
        b.addEventListener('click', () => apply(b.dataset.series, true));
      }

      const initial = new URL(location.href).searchParams.get('series');
      const valid = buttons.some((b) => b.dataset.series === initial);
      apply(valid ? initial : 'All', false);
    })();
  </script>
</BaseLayout>
