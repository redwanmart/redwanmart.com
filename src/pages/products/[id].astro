---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const { id } = Astro.params;

// Fetch product details
let product = null;
let reviews = [];

try {
  const baseUrl = Astro.site?.origin || 'https://redwanmart.com';
  const productRes = await fetch(`${baseUrl}/api/products/${id}`);
  const productData = await productRes.json();

  if (productData.success) {
    product = productData.product;

    // Fetch reviews
    const reviewsRes = await fetch(
      `${baseUrl}/api/reviews?productId=${product.id || id}&limit=5`
    );
    const reviewsData = await reviewsRes.json();
    if (reviewsData.success) {
      reviews = reviewsData.reviews || [];
    }
  }
} catch (error) {
  console.error('Failed to fetch product:', error);
}

// Fallback product data
if (!product) {
  product = {
    id: id,
    name: 'Premium Wireless Headphones',
    slug: 'premium-wireless-headphones',
    description: 'High-quality wireless headphones with noise cancellation and 30-hour battery life.',
    price: 199.99,
    category: 'Audio',
    sku: 'HEAD-001',
    image_url: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&h=800&fit=crop',
    rating: 4.8,
    reviews_count: 245,
    in_stock: true,
    stock_quantity: 45,
  };
}

const title = `${product.name} | Redwan Mart`;
const description = product.description || 'Premium product from Redwan Mart';
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-4">
      <div class="flex gap-2 text-gray-600 text-sm">
        <a href="/" class="hover:text-red-600">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-red-600">Products</a>
        <span>/</span>
        <a href={`/products?category=${product.category}`} class="hover:text-red-600">{product.category}</a>
        <span>/</span>
        <span class="text-gray-900 font-semibold">{product.name}</span>
      </div>
    </div>
  </div>

  <!-- Product Detail -->
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
      <!-- Product Image -->
      <div class="flex items-center justify-center bg-gray-100 rounded-lg overflow-hidden">
        <img
          src={product.image_url || '/placeholder-product.jpg'}
          alt={product.name}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Product Info -->
      <div>
        <div class="mb-6">
          <p class="text-sm font-semibold text-red-600 uppercase mb-2">{product.category}</p>
          <h1 class="text-4xl font-bold text-gray-900 mb-4">{product.name}</h1>

          <!-- Rating -->
          <div class="flex items-center gap-4 mb-6">
            <div class="flex gap-1">
              {[...Array(5)].map((_, i) => (
                <span key={i} class="text-2xl">
                  {i < Math.floor(product.rating || 0) ? '★' : '☆'}
                </span>
              ))}
            </div>
            <span class="text-gray-600">
              {product.rating} ({product.reviews_count} reviews)
            </span>
          </div>

          <!-- Price -->
          <p class="text-4xl font-bold text-red-600 mb-2">${product.price.toFixed(2)}</p>

          <!-- Stock Status -->
          <p class={`text-sm font-semibold mb-6 ${product.in_stock ? 'text-green-600' : 'text-red-600'}`}>
            {product.in_stock ? `✓ In Stock (${product.stock_quantity} available)` : '✗ Out of Stock'}
          </p>

          <!-- Description -->
          <p class="text-gray-700 text-lg mb-8 leading-relaxed">{product.description}</p>

          <!-- Actions -->
          <div class="flex gap-4 mb-8">
            <button
              class="flex-1 bg-red-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-red-700 transition disabled:opacity-50 disabled:cursor-not-allowed"
              disabled={!product.in_stock}
            >
              Add to Cart
            </button>
            <button class="px-6 py-4 border-2 border-gray-300 rounded-lg font-semibold hover:border-red-600 transition">
              ♡ Wishlist
            </button>
          </div>

          <!-- Product Details -->
          <div class="border-t border-b border-gray-200 py-6">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <p class="text-sm text-gray-600 mb-1">SKU</p>
                <p class="font-semibold text-gray-900">{product.sku}</p>
              </div>
              <div>
                <p class="text-sm text-gray-600 mb-1">Category</p>
                <p class="font-semibold text-gray-900">{product.category}</p>
              </div>
            </div>
          </div>

          <!-- Shipping Info -->
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <span class="text-2xl">🚚</span>
              <div>
                <p class="font-semibold text-gray-900">Free Shipping</p>
                <p class="text-sm text-gray-600">On orders over $100</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-2xl">🛡️</span>
              <div>
                <p class="font-semibold text-gray-900">Secure Payment</p>
                <p class="text-sm text-gray-600">100% encrypted transactions</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-2xl">♻️</span>
              <div>
                <p class="font-semibold text-gray-900">Easy Returns</p>
                <p class="text-sm text-gray-600">30-day money-back guarantee</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Reviews Section -->
    <div class="border-t border-gray-200 pt-12">
      <h2 class="text-3xl font-bold mb-8">Customer Reviews</h2>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Review Stats -->
        <div class="bg-gray-50 p-8 rounded-lg">
          <div class="text-center mb-6">
            <p class="text-5xl font-bold text-gray-900">{product.rating}</p>
            <div class="flex justify-center gap-1 my-2">
              {[...Array(5)].map((_, i) => (
                <span key={i} class="text-2xl">
                  {i < Math.floor(product.rating || 0) ? '★' : '☆'}
                </span>
              ))}
            </div>
            <p class="text-gray-600">Based on {product.reviews_count} reviews</p>
          </div>
        </div>

        <!-- Recent Reviews -->
        <div class="lg:col-span-2">
          {reviews.length > 0 ? (
            <div class="space-y-6">
              {reviews.map((review: any) => (
                <div key={review.id} class="border-b border-gray-200 pb-6">
                  <div class="flex items-start gap-4 mb-3">
                    <div>
                      <p class="font-semibold text-gray-900">{review.userName}</p>
                      <div class="flex gap-1">
                        {[...Array(5)].map((_, i) => (
                          <span key={i} class="text-lg">
                            {i < review.rating ? '★' : '☆'}
                          </span>
                        ))}
                      </div>
                    </div>
                    {review.verified_purchase && (
                      <span class="text-xs font-semibold text-green-600 bg-green-50 px-2 py-1 rounded">
                        Verified Purchase
                      </span>
                    )}
                  </div>
                  <p class="font-semibold text-gray-900 mb-2">{review.title}</p>
                  <p class="text-gray-700 mb-3">{review.comment}</p>
                  <p class="text-sm text-gray-500">
                    {new Date(review.created_at).toLocaleDateString()} • {review.helpful_count} helpful
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-gray-600 text-center py-8">No reviews yet. Be the first to review!</p>
          )}

          <button class="mt-6 w-full border-2 border-red-600 text-red-600 px-6 py-3 rounded-lg font-semibold hover:bg-red-50 transition">
            Write a Review
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
