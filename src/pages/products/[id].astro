---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/product-grid/ProductCard.astro';
import { products, relatedProducts, formatPrice, CURRENCY } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = relatedProducts(product.id, 3);
const discount = product.compareAt
  ? Math.round((1 - product.price / product.compareAt) * 100)
  : 0;

const specs = [
  ['Model', product.model],
  ['Series', product.series],
  ['Finished size', product.size],
  ['Recommended age', product.ages],
  ['Contents', `${product.pieces} + instruction booklet`],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: [new URL(product.image, 'https://redwanmart.com').href],
  description: product.description,
  sku: product.model,
  brand: { '@type': 'Brand', name: 'Redwan Mart' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviews,
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'BDT',
    price: product.price,
    availability: product.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    url: new URL(`/products/${product.id}`, 'https://redwanmart.com').href,
  },
};

const mailSubject = encodeURIComponent(`Order enquiry — ${product.name} (${product.model})`);
const mailBody = encodeURIComponent(
  `Hello Redwan Mart,\n\nI would like to order:\n\n` +
  `Product: ${product.name}\nModel: ${product.model}\nPrice: ${CURRENCY}${product.price}\nQuantity: 1\n\n` +
  `Delivery name:\nDelivery address:\nPhone number:\n\nThank you.`
);
---

<BaseLayout
  title={`${product.name} (${product.model}) | Redwan Mart`}
  description={product.description}
  image={product.image}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="container-app pt-8">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-muted">
      <a href="/" class="hover:text-brand-700">Home</a>
      <span class="mx-2 text-ink-faint">/</span>
      <a href="/products" class="hover:text-brand-700">Shop</a>
      <span class="mx-2 text-ink-faint">/</span>
      <span class="font-semibold text-ink">{product.name}</span>
    </nav>
  </div>

  <section class="container-app grid gap-12 py-10 lg:grid-cols-2 lg:gap-16 lg:py-14">
    <div class="relative self-start overflow-hidden rounded-3xl bg-surface-sunken shadow-card ring-1 ring-black/5 lg:sticky lg:top-28">
      <picture>
        <source srcset={product.imageWebp} type="image/webp" />
        <img
          src={product.image} alt={`${product.name} — model ${product.model}`}
          width="1200" height="1200" fetchpriority="high" decoding="async"
          class="aspect-square w-full object-cover"
        />
      </picture>
      {discount > 0 && (
        <span class="absolute left-4 top-4 rounded-full bg-brand-600 px-3.5 py-1.5 text-sm font-bold text-white shadow-card">
          Save {discount}%
        </span>
      )}
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-ink-faint">
        {product.series} · Model {product.model}
      </p>
      <h1 class="mt-3 font-heading text-title">{product.name}</h1>

      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
        <span class="flex items-center gap-1.5">
          <span class="flex text-gold-400" aria-hidden="true">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg class:list={['h-4 w-4', i < Math.round(product.rating) ? 'fill-current' : 'fill-surface-line']} viewBox="0 0 20 20">
                <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
              </svg>
            ))}
          </span>
          <span class="font-semibold text-ink">{product.rating.toFixed(1)}</span>
          <span class="text-ink-muted">({product.reviews} reviews)</span>
        </span>
        {product.inStock ? (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> In stock
          </span>
        ) : (
          <span class="rounded-full bg-surface-sunken px-3 py-1 text-xs font-bold text-ink-muted">Sold out</span>
        )}
      </div>

      <div class="mt-6 flex items-baseline gap-3">
        <span class="font-heading text-4xl font-bold text-ink">{formatPrice(product.price)}</span>
        {product.compareAt && (
          <span class="text-lg text-ink-faint line-through">{formatPrice(product.compareAt)}</span>
        )}
      </div>

      <p class="mt-6 text-lg leading-relaxed text-ink-soft">{product.description}</p>

      <ul class="mt-7 space-y-3">
        {product.highlights.map((h) => (
          <li class="flex items-start gap-3 text-[0.98rem] text-ink-soft">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" stroke="currentColor" stroke-width="2.3" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            {h}
          </li>
        ))}
      </ul>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href={`mailto:redwanmartbd@gmail.com?subject=${mailSubject}&body=${mailBody}`} class="btn-primary flex-1 px-7 py-4 text-base sm:flex-none">
          Order by email
        </a>
        <a href="/products" class="btn-outline px-7 py-4 text-base">Keep browsing</a>
      </div>
      <p class="mt-3 text-sm text-ink-muted">
        Cash on delivery available · Dhaka 1–2 days, nationwide 3–5 days
      </p>

      <dl class="mt-10 divide-y divide-surface-line border-y border-surface-line">
        {specs.map(([k, v]) => (
          <div class="flex items-center justify-between gap-6 py-3.5">
            <dt class="text-sm font-semibold text-ink-muted">{k}</dt>
            <dd class="text-right text-sm font-semibold text-ink">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {related.length > 0 && (
    <section class="border-t border-surface-line bg-surface-soft py-16 lg:py-20">
      <div class="container-app">
        <h2 class="text-title">You might also like</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
