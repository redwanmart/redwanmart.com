---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';

const values = [
  {
    title: 'Small range, high bar',
    body: 'Six figures, not six hundred. Everything in the catalogue is something we would put on our own shelf.',
  },
  {
    title: 'Open about what we are',
    body: 'A young shop run out of Dhaka. No inflated claims about warehouses or teams we do not have.',
  },
  {
    title: 'The founder answers',
    body: 'Every message goes to the same inbox. Questions before you buy, problems after — same person either way.',
  },
  {
    title: 'Checked, then sealed',
    body: 'Boxes are opened and counted before dispatch, because a missing brick ruins the whole build.',
  },
];

const milestones = [
  { year: '2025', title: 'Enrolled at BUBT', body: 'Began a BBA at Bangladesh University of Business and Technology, Intake 65.' },
  { year: '2025', title: 'Redwan Mart begins', body: 'Started sourcing and reselling micro-brick hero figures to collectors in Dhaka.' },
  { year: '2026', title: 'redwanmart.com goes live', body: 'The catalogue moves online, built on Astro and Cloudflare’s edge platform.' },
];
---

<BaseLayout
  title="About Redwan Mart & founder S. M. Redwan Ahmed"
  description="Redwan Mart is a micro-brick collectibles shop in Dhaka, founded by S. M. Redwan Ahmed, a BBA student at Bangladesh University of Business and Technology."
  image="/founder.jpg"
>
  <!-- hero -->
  <section class="relative overflow-hidden border-b border-surface-line bg-surface-soft">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-brand-100/60 blur-3xl" aria-hidden="true"></div>
    <div class="container-app relative py-16 lg:py-20">
      <p class="eyebrow">About us</p>
      <h1 class="mt-4 max-w-3xl text-display">
        A collectibles shop with <span class="text-brand-600">one person's name</span> on it.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Redwan Mart sells micro-brick hero figures to collectors across
        Bangladesh. It is small on purpose — the range is short, the stock is
        checked by hand, and the person who picks it is the person who replies
        when you write in.
      </p>
    </div>
  </section>

  <!-- founder -->
  <section id="founder" class="scroll-mt-24 py-20 lg:py-24">
    <div class="container-app grid items-start gap-14 lg:grid-cols-[0.85fr_1fr] lg:gap-20">
      <div class="lg:sticky lg:top-28">
        <div class="relative mx-auto w-full max-w-sm">
          <div class="absolute -inset-3 rotate-2 rounded-3xl bg-brand-100" aria-hidden="true"></div>
          <picture>
            <source srcset="/founder.webp" type="image/webp" />
            <img
              src="/founder.jpg"
              alt="S. M. Redwan Ahmed, founder and CEO of Redwan Mart"
              width="1000" height="1250" decoding="async"
              class="relative w-full rounded-3xl object-cover shadow-lift"
            />
          </picture>
        </div>

        <div class="mx-auto mt-8 max-w-sm text-center">
          <h2 class="font-heading text-2xl text-ink">S. M. Redwan Ahmed</h2>
          <p class="mt-1 font-semibold text-brand-600">Founder &amp; Chief Executive</p>
          <p class="mt-3 text-sm text-ink-muted">
            BBA candidate, Bangladesh University of Business and Technology (BUBT)
            · Intake 65 · Dhaka, Bangladesh
          </p>
          <a href="mailto:redwanmartbd@gmail.com" class="btn-outline mt-6 w-full">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
            Email Redwan
          </a>
        </div>
      </div>

      <div>
        <p class="eyebrow">The founder</p>
        <h2 class="mt-3 text-title">Why this shop exists</h2>

        <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-soft">
          <p>
            Redwan Ahmed started Redwan Mart while studying for a Bachelor of
            Business Administration at BUBT in Dhaka. The idea was narrow and
            deliberate: micro-brick hero figures were easy to find online and
            hard to trust — boxes arrived short of pieces, photos did not match
            what turned up, and nobody answered when something went wrong.
          </p>
          <p>
            So the shop was built around the opposite of that. A short catalogue
            he can personally vouch for. Boxes opened and counted before they
            ship. One inbox, answered by the person whose name is above the door.
          </p>
          <p>
            He runs the sourcing, the quality checks, the photography and the
            customer messages himself, alongside a full course load. The
            catalogue stays at six figures because that is what one person can
            stand behind properly.
          </p>
        </div>

        <blockquote class="mt-9 rounded-2xl border-l-4 border-brand-600 bg-surface-soft p-7">
          <p class="font-heading text-xl leading-snug text-ink">
            “I would rather sell six things properly than sixty things badly.
            Every box that leaves here has been opened and checked — that is the
            whole business model.”
          </p>
          <footer class="mt-4 text-sm font-semibold text-ink-muted">
            — S. M. Redwan Ahmed, Founder &amp; Chief Executive
          </footer>
        </blockquote>

        <h3 class="mt-14 font-heading text-xl text-ink">How it got here</h3>
        <ol class="mt-6 space-y-6 border-l border-surface-line pl-7">
          {milestones.map((m) => (
            <li class="relative">
              <span class="absolute -left-[2.15rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-brand-600 ring-1 ring-surface-line"></span>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">{m.year}</p>
              <p class="mt-1 font-bold text-ink">{m.title}</p>
              <p class="mt-1 text-[0.97rem] leading-relaxed text-ink-soft">{m.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- values -->
  <section class="border-y border-surface-line bg-surface-soft py-20 lg:py-24">
    <div class="container-app">
      <div class="max-w-xl">
        <p class="eyebrow">What we hold to</p>
        <h2 class="mt-3 text-title">Four things we do not bend on.</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {values.map((v, i) => (
          <div class="card p-7">
            <span class="font-heading text-3xl text-brand-200">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-bold text-ink">{v.title}</h3>
            <p class="mt-2.5 text-[0.97rem] leading-relaxed text-ink-soft">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- catalogue callout -->
  <section class="py-20 lg:py-24">
    <div class="container-app grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">The range</p>
        <h2 class="mt-3 text-title">{products.length} figures, checked by hand.</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          Two series — Hero Block and Spidey Block — from 5.6 cm to 6.2 cm
          finished height, all rated for builders aged 14 and up. Each box
          contains the bricks and an illustrated assembly booklet.
        </p>
        <a href="/products" class="btn-primary mt-8">
          Browse the collection
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {products.slice(0, 6).map((p) => (
          <a href={`/products/${p.id}`} class="overflow-hidden rounded-xl bg-surface-sunken ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-card">
            <img src={p.thumb} alt={p.name} width="600" height="600" loading="lazy" decoding="async" class="aspect-square w-full object-cover" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- contact -->
  <section class="container-app pb-4">
    <div class="relative overflow-hidden rounded-3xl gradient-ink px-8 py-16 text-center sm:px-16">
      <div class="absolute inset-0 bg-dotgrid opacity-60" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="font-heading text-3xl text-white sm:text-4xl">Questions before you order?</h2>
        <p class="mt-4 text-lg text-white/70">
          Write in and Redwan will answer — usually the same day.
        </p>
        <a href="mailto:redwanmartbd@gmail.com" class="btn-secondary mt-9 px-7 py-3.5 text-base">
          redwanmartbd@gmail.com
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
