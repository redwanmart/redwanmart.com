---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About Redwan Mart | Premium E-Commerce Platform';
const description = 'Learn about Redwan Mart, founded by S. M. Redwan Ahmed. A premium e-commerce platform delivering quality products and exceptional service.';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-b from-gray-50 to-white">
    <!-- Hero Section -->
    <section class="bg-rm-red text-white py-20">
      <div class="max-w-7xl mx-auto px-6">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">About Redwan Mart</h1>
        <p class="text-xl md:text-2xl text-gray-100">
          Premium e-commerce platform delivering quality products and exceptional service
        </p>
      </div>
    </section>

    <!-- Company Overview -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-bold text-gray-900 mb-6">Our Mission</h2>
            <p class="text-lg text-gray-700 mb-4">
              Redwan Mart is committed to providing a premium e-commerce experience through innovative technology,
              curated product selection, and exceptional customer service. We believe in connecting quality products
              with customers who appreciate value and reliability.
            </p>
            <p class="text-lg text-gray-700 mb-6">
              Our platform leverages cutting-edge technology to deliver seamless shopping experiences,
              AI-powered personalization, and secure transactions. Every product is carefully selected to
              ensure customer satisfaction and loyalty.
            </p>
            <div class="flex gap-4">
              <div class="flex-1">
                <div class="text-4xl font-bold text-rm-red">100%</div>
                <p class="text-gray-600">Authentic Products</p>
              </div>
              <div class="flex-1">
                <div class="text-4xl font-bold text-rm-red">24/7</div>
                <p class="text-gray-600">Customer Support</p>
              </div>
              <div class="flex-1">
                <div class="text-4xl font-bold text-rm-red">Fast</div>
                <p class="text-gray-600">Shipping</p>
              </div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-rm-red to-rm-gold rounded-lg p-8 text-white">
            <h3 class="text-2xl font-bold mb-4">Company Values</h3>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Quality Excellence</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Customer-Centric Approach</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Innovation & Technology</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Integrity & Transparency</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Continuous Growth</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Founder Profile Section -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl font-bold text-center text-gray-900 mb-16">Founder & CEO</h2>

        <div class="bg-white rounded-lg shadow-xl overflow-hidden">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 p-8 md:p-12">
            <!-- Founder Image -->
            <div class="flex flex-col items-center justify-center">
              <div class="w-full max-w-sm rounded-lg overflow-hidden shadow-lg mb-6">
                <img
                  src="/founder.jpg"
                  alt="S. M. Redwan Ahmed - Founder & CEO"
                  class="w-full h-auto object-cover"
                />
              </div>
              <h3 class="text-3xl font-bold text-gray-900">S. M. Redwan Ahmed</h3>
              <p class="text-xl text-rm-red font-semibold mt-2">Founder & CEO</p>
              <div class="flex gap-4 mt-6">
                <a href="https://www.linkedin.com/in/redwan-ahmed" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-rm-red transition">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                </a>
                <a href="mailto:redwanmartbd@gmail.com" class="text-gray-600 hover:text-rm-red transition">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Founder Bio -->
            <div>
              <div class="mb-8">
                <h4 class="text-2xl font-bold text-gray-900 mb-4">Professional Background</h4>
                <div class="space-y-3 text-gray-700">
                  <p class="flex items-start gap-3">
                    <span class="text-rm-red font-bold mt-1">🎓</span>
                    <span><strong>Education:</strong> Bachelor of Business Administration (BBA) from Bangladesh University of Business and Technology (BUBT), Intake 65 (2025-2029)</span>
                  </p>
                  <p class="flex items-start gap-3">
                    <span class="text-rm-red font-bold mt-1">💼</span>
                    <span><strong>Specialization:</strong> E-Commerce, Technology Innovation, and Digital Business Strategy</span>
                  </p>
                  <p class="flex items-start gap-3">
                    <span class="text-rm-red font-bold mt-1">🏢</span>
                    <span><strong>Expertise:</strong> Building scalable digital platforms, AI-powered solutions, and customer-centric business models</span>
                  </p>
                </div>
              </div>

              <div class="mb-8">
                <h4 class="text-2xl font-bold text-gray-900 mb-4">Vision & Leadership</h4>
                <p class="text-gray-700 mb-3">
                  Redwan Ahmed is a visionary entrepreneur dedicated to revolutionizing the e-commerce landscape in Bangladesh and beyond.
                  With a strong educational foundation and deep passion for technology, he founded Redwan Mart to deliver premium products
                  and exceptional shopping experiences to customers worldwide.
                </p>
                <p class="text-gray-700">
                  Under his leadership, Redwan Mart leverages cutting-edge technology including AI media generation, cloud infrastructure,
                  and data analytics to create a seamless, personalized shopping platform that sets new standards for quality and service excellence.
                </p>
              </div>

              <div class="mb-8">
                <h4 class="text-2xl font-bold text-gray-900 mb-4">Key Achievements</h4>
                <ul class="space-y-2 text-gray-700">
                  <li class="flex items-center gap-3">
                    <span class="text-rm-gold text-xl">★</span>
                    Built Redwan Mart from concept to live production platform
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="text-rm-gold text-xl">★</span>
                    Integrated advanced AI media generation (Higgsfield) for product showcases
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="text-rm-gold text-xl">★</span>
                    Architected scalable 2-layer serverless infrastructure on Cloudflare
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="text-rm-gold text-xl">★</span>
                    Implemented comprehensive admin dashboard and analytics system
                  </li>
                </ul>
              </div>

              <div class="p-6 bg-gradient-to-r from-rm-red to-rm-gold rounded-lg text-white">
                <p class="font-semibold text-lg">
                  "Our mission is to make premium products accessible to everyone while maintaining the highest standards of quality,
                  service, and innovation."
                </p>
                <p class="text-sm mt-3 opacity-90">— S. M. Redwan Ahmed, Founder & CEO</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Platform Features Section -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl font-bold text-center text-gray-900 mb-12">Why Choose Redwan Mart</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition">
            <div class="text-4xl mb-4">🚀</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Cutting-Edge Technology</h3>
            <p class="text-gray-600">
              Built on Astro + Cloudflare infrastructure with AI-powered media generation, real-time analytics, and serverless scalability.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition">
            <div class="text-4xl mb-4">⭐</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Premium Curated Products</h3>
            <p class="text-gray-600">
              Hand-selected products across categories, from collectibles to electronics, all vetted for quality and authenticity.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition">
            <div class="text-4xl mb-4">💝</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Exceptional Customer Service</h3>
            <p class="text-gray-600">
              24/7 support, fast shipping, hassle-free returns, and personalized recommendations powered by advanced analytics.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="bg-rm-red text-white py-16">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold mb-6">Get in Touch</h2>
        <p class="text-xl mb-8">Have questions or want to collaborate? We'd love to hear from you.</p>
        <div class="flex flex-col md:flex-row gap-6 justify-center items-center">
          <a href="mailto:redwanmartbd@gmail.com" class="bg-white text-rm-red px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
            Email Us
          </a>
          <a href="/contact" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-rm-red transition">
            Contact Page
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
