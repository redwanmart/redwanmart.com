---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product-grid/ProductCard.astro';
import { products } from '../data/products';

/**
 * The site is a static build, so the query string is not available at render
 * time. Every product is rendered up front and filtered in the browser — a
 * few dozen items is still cheaper than a round trip to the API.
 */
const index = products.map((p) => ({
  id: p.id,
  haystack: [p.name, p.series, p.model, p.description, p.tagline].join(' ').toLowerCase(),
}));
---

<BaseLayout
  title="Search | Redwan Mart"
  description="Search the Redwan Mart catalogue of micro-brick hero figures."
>
  <section class="border-b border-surface-line bg-surface-soft">
    <div class="container-app py-14 lg:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-muted">
        <a href="/" class="hover:text-brand-700">Home</a>
        <span class="mx-2 text-ink-faint">/</span>
        <span class="font-semibold text-ink">Search</span>
      </nav>
      <h1 class="mt-4 text-title">Search the catalogue</h1>

      <form id="search-form" role="search" class="mt-7 flex max-w-xl gap-3">
        <label for="q" class="sr-only">Search products</label>
        <input
          id="q" name="q" type="search" autocomplete="off"
          placeholder="Try “spidey”, “dark knight”, or a model number…"
          class="field flex-1"
        />
        <button type="submit" class="btn-primary px-6">Search</button>
      </form>

      <p id="summary" class="mt-4 text-sm text-ink-muted" aria-live="polite"></p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-app">
      <div id="results" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <div class="result-item" data-id={p.id}>
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <div id="empty" hidden class="py-16 text-center">
        <p class="text-lg font-semibold text-ink">No matches.</p>
        <p class="mt-2 text-ink-muted">Try a shorter word, or browse the full range.</p>
        <a href="/products" class="btn-outline mt-7">View all products</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ index }}>
    (() => {
      const form = document.getElementById('search-form');
      const input = document.getElementById('q');
      const summary = document.getElementById('summary');
      const empty = document.getElementById('empty');
      const items = [...document.querySelectorAll('.result-item')];
      const byId = new Map(index.map((e) => [e.id, e.haystack]));

      function run(term, push) {
        const q = (term || '').trim().toLowerCase();
        let shown = 0;
        for (const el of items) {
          const hay = byId.get(el.dataset.id) || '';
          const match = !q || q.split(/\s+/).every((w) => hay.includes(w));
          el.hidden = !match;
          if (match) shown++;
        }
        empty.hidden = shown !== 0;
        summary.textContent = q
          ? `${shown} result${shown === 1 ? '' : 's'} for “${term.trim()}”`
          : `Showing all ${items.length} products`;
        if (push) {
          const url = new URL(location.href);
          if (q) url.searchParams.set('q', term.trim());
          else url.searchParams.delete('q');
          history.replaceState({}, '', url);
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        run(input.value, true);
      });
      input.addEventListener('input', () => run(input.value, true));

      const initial = new URL(location.href).searchParams.get('q') || '';
      input.value = initial;
      run(initial, false);
    })();
  </script>
</BaseLayout>
