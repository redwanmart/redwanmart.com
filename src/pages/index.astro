---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import ProductCard from '../components/product-grid/ProductCard.astro';

// Mock product data (will be replaced with database queries)
const products = [
  {
    id: '1',
    name: 'Premium Wireless Headphones',
    price: 199.99,
    image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&h=500&fit=crop',
    category: 'Electronics',
    rating: 4.8,
    reviews: 245,
    inStock: true,
  },
  {
    id: '2',
    name: 'Smartwatch Pro Series',
    price: 349.99,
    image: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&h=500&fit=crop',
    category: 'Wearables',
    rating: 4.6,
    reviews: 189,
    inStock: true,
  },
  {
    id: '3',
    name: 'Ultra HD Camera',
    price: 899.99,
    image: 'https://images.unsplash.com/photo-1612198188060-c7c2a3b66eae?w=500&h=500&fit=crop',
    category: 'Photography',
    rating: 4.9,
    reviews: 156,
    inStock: true,
  },
  {
    id: '4',
    name: 'Portable Speaker',
    price: 79.99,
    image: 'https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?w=500&h=500&fit=crop',
    category: 'Audio',
    rating: 4.5,
    reviews: 312,
    inStock: true,
  },
  {
    id: '5',
    name: 'Wireless Charging Pad',
    price: 39.99,
    image: 'https://images.unsplash.com/photo-1591290619762-a3c5d2e45b58?w=500&h=500&fit=crop',
    category: 'Accessories',
    rating: 4.4,
    reviews: 423,
    inStock: true,
  },
  {
    id: '6',
    name: 'Premium Backpack',
    price: 129.99,
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&h=500&fit=crop',
    category: 'Bags',
    rating: 4.7,
    reviews: 278,
    inStock: false,
  },
];
---

<BaseLayout title="Redwan Mart - Premium E-Commerce Experience">
  {/* Hero Section */}
  <HeroSection
    title="Welcome to Redwan Mart"
    subtitle="Discover premium products handpicked for quality and excellence. Shop the latest electronics, accessories, and lifestyle products."
    ctaText="Shop Now"
    ctaLink="/products"
  />

  {/* Featured Products */}
  <section id="featured" class="py-16 md:py-24 bg-white">
    <div class="container-app">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-rm-gray mb-4">
          Featured Products
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Explore our carefully curated selection of premium products designed to enhance your lifestyle.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.slice(0, 6).map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/products" class="btn btn-primary inline-block">
          View All Products
        </a>
      </div>
    </div>
  </section>

  {/* Benefits Section */}
  <section class="py-16 md:py-24 bg-rm-gray-light">
    <div class="container-app">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-rm-gray mb-12 text-center">
        Why Choose Redwan Mart?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Benefit 1 */}
        <div class="card p-6 text-center">
          <div class="w-16 h-16 bg-rm-red/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-rm-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-rm-gray mb-2">Premium Quality</h3>
          <p class="text-gray-600">
            All our products are carefully selected and tested to ensure the highest quality standards.
          </p>
        </div>

        {/* Benefit 2 */}
        <div class="card p-6 text-center">
          <div class="w-16 h-16 bg-rm-gold/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-rm-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-rm-gray mb-2">Fast Shipping</h3>
          <p class="text-gray-600">
            Quick and reliable delivery to your doorstep. Track your order in real-time.
          </p>
        </div>

        {/* Benefit 3 */}
        <div class="card p-6 text-center">
          <div class="w-16 h-16 bg-rm-red/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-rm-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.172l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-rm-gray mb-2">24/7 Support</h3>
          <p class="text-gray-600">
            Our dedicated support team is ready to help you anytime, anywhere.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Call to Action */}
  <section class="py-16 md:py-24 bg-gradient-rm text-white">
    <div class="container-app text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
        Ready to Experience Excellence?
      </h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto">
        Join thousands of satisfied customers who trust Redwan Mart for their premium product needs.
      </p>
      <a href="/products" class="btn btn-secondary inline-block">
        Start Shopping Today
      </a>
    </div>
  </section>
</BaseLayout>
