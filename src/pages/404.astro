---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product-grid/ProductCard.astro';
import { featuredProducts } from '../data/products';

const suggestions = featuredProducts().slice(0, 3);
---

<BaseLayout
  title="Page not found | Redwan Mart"
  description="That page does not exist. Browse the Redwan Mart collection of micro-brick hero figures instead."
>
  <section class="container-app py-24 text-center lg:py-32">
    <img src="/brand/mark.png" alt="" width="512" height="512" class="mx-auto h-16 w-16 opacity-90" aria-hidden="true" />

    <p class="eyebrow mt-8">Error 404</p>
    <h1 class="mt-3 text-display">This one is not on the shelf.</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
      The page you were after does not exist — it may have moved, or the link
      may be mistyped. The whole collection is two clicks away.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/products" class="btn-primary px-7 py-3.5 text-base">
        Browse the collection
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
      <a href="/" class="btn-outline px-7 py-3.5 text-base">Back to home</a>
    </div>

    <form action="/search" method="get" class="mx-auto mt-10 flex max-w-md gap-3">
      <label for="nf-search" class="sr-only">Search products</label>
      <input id="nf-search" type="search" name="q" placeholder="Search figures…" class="field flex-1" />
      <button type="submit" class="btn-outline px-6">Search</button>
    </form>
  </section>

  <section class="border-t border-surface-line bg-surface-soft py-16 lg:py-20">
    <div class="container-app">
      <h2 class="text-title">Popular right now</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {suggestions.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
