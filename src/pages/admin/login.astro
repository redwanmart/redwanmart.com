---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Check if already logged in
const authCookie = Astro.request.headers.get('cookie')?.includes('token=');
if (authCookie) {
  return Astro.redirect('/admin/dashboard');
}

const title = 'Admin Login | Redwan Mart';
const description = 'Administrator login for Redwan Mart dashboard';
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-br from-red-600 to-red-700 flex items-center justify-center px-6">
    <div class="w-full max-w-md">
      <!-- Login Card -->
      <div class="bg-white rounded-lg shadow-2xl p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <h1 class="text-3xl font-bold text-red-600 mb-2">Redwan Mart</h1>
          <p class="text-gray-600">Admin Dashboard</p>
        </div>

        <!-- Login Form -->
        <form id="loginForm" class="space-y-6">
          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="admin@redwanmart.com"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-600 focus:border-transparent transition"
              required
            />
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">
              Password
            </label>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-600 focus:border-transparent transition"
              required
            />
          </div>

          <!-- Remember Me -->
          <div class="flex items-center">
            <input
              type="checkbox"
              id="remember"
              name="remember"
              class="w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-600"
            />
            <label for="remember" class="ml-2 text-sm text-gray-600">Remember me</label>
          </div>

          <!-- Error Message -->
          <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
            Invalid email or password
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-red-600 text-white py-3 rounded-lg font-semibold hover:bg-red-700 transition focus:ring-2 focus:ring-offset-2 focus:ring-red-600"
          >
            Sign In
          </button>

          <!-- Loading State -->
          <div id="loadingState" class="hidden text-center py-2">
            <div class="inline-block animate-spin">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </div>
            <p class="text-sm text-gray-600 mt-2">Signing in...</p>
          </div>
        </form>

        <!--
          A "Demo Credentials" panel printing the admin email and password
          used to sit here. On a public site that hands anyone who opens
          /admin/login a working way in, so it has been removed.
        -->

        <!-- Footer -->
        <div class="mt-8 text-center text-sm text-gray-600">
          <p>
            Not an admin?
            <a href="/" class="text-red-600 font-semibold hover:underline">
              Back to store
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const loginForm = document.getElementById('loginForm');
    const errorMessage = document.getElementById('errorMessage');
    const loadingState = document.getElementById('loadingState');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous errors
      errorMessage?.classList.add('hidden');
      loadingState?.classList.remove('hidden');

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email: emailInput?.value,
            password: passwordInput?.value,
          }),
        });

        const data = await response.json();

        if (data.success && data.token) {
          // Store token
          localStorage.setItem('authToken', data.token);

          // Redirect to dashboard
          window.location.href = '/admin/dashboard';
        } else {
          // Show error
          loadingState?.classList.add('hidden');
          errorMessage?.classList.remove('hidden');

          // Clear password
          if (passwordInput) passwordInput.value = '';
        }
      } catch (error) {
        console.error('Login error:', error);
        loadingState?.classList.add('hidden');
        errorMessage?.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
